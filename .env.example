# ==========================================================================
# Samsara → Telegram poller — environment variables (standalone service)
# Copy this file to `.env` and fill in the real values.
#
# IMPORTANT: DATABASE_URL and BOT_TOKEN MUST be identical to the values used
# by the main "driver-feedback-bot" hub. That shared database + shared bot are
# how the two services keep talking to each other after the split.
# ==========================================================================

# --- Telegram bots ---
# The Samsara notification bot's OWN token (e.g. @wenzesambot). This bot MUST be
# a member of the "Samsara Notifications" group (HARDCODED_GROUP_ID) or sends to
# it fail with "chat not found". Preferred over TELEGRAM_BOT_TOKEN when set.
SAMSARA_BOT_TOKEN=

# Legacy alias for the Samsara notification bot token — only used when
# SAMSARA_BOT_TOKEN is unset. Do NOT point this at a different bot (e.g. a leads
# bot); it must be the bot that posts into the notifications group.
TELEGRAM_BOT_TOKEN=

# The MAIN feedback bot token (e.g. @wenzefeedback_bot). Used send-only to post
# the video + friendly caption into the matched driver group. Same value as the
# main hub's BOT_TOKEN.
BOT_TOKEN=

# --- Samsara API ---
# FALLBACKS. The admin panel (bot-backend → Settings → Samsara) is the primary
# home for these now; it writes a `samsara_settings` row this service reads over
# the shared database. A value saved there wins; these are what runs when
# nothing is saved, which is why an existing deployment needs no change.
SAMSARA_API_KEY=
SAMSARA_API_BASE=https://api.samsara.com

# --- Missing-video recovery (attach dashcam video after the alert is sent) ---
# Alerts go out IMMEDIATELY (text-only when the clip hasn't uploaded yet), and a
# DURABLE recovery job is written to Postgres so a restart or redeploy during
# the wait loses nothing. Configure the delays, the retry budget and the footage
# window in the admin panel — no environment variable is needed for any of it.
#
# "false" still vetoes recovery outright (text-only alerts, never enriched),
# whatever the panel says.
SAMSARA_VIDEO_RETRY_ENABLED=true
# Fallback initial re-check delay, in ms, used only when the settings row is
# unavailable. The admin panel's default is 5 minutes. There is no longer an
# upper clamp — the old 30s…180s ceiling silently overrode the chosen delay.
SAMSARA_VIDEO_RETRY_DELAY_MS=300000

# --- Optional: strengthen the shared secret ---
# The Samsara API key saved in the admin panel is encrypted with a key derived
# from the DATABASE_URL credentials, which both services already hold. Setting
# the SAME value here and on bot-backend decouples it from those credentials.
# Leave blank unless you set it on BOTH services.
INTEGRATION_SECRET_KEY=

# --- Shared PostgreSQL database (MUST match the main hub's DATABASE_URL) ---
DATABASE_URL=

# --- Group routing ---
MANAGEMENT_GROUP_ID=
EMPLOYEE_GROUP_ID=
# Optional: the fixed "Samsara Notifications" group id. Leave blank to use the
# built-in default baked into the code.
HARDCODED_GROUP_ID=

# --- AI for the friendly driver-group caption (the "joke" message) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Optional: persistent subscriber storage (survives redeploys) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Local health-check server port (Render sets PORT automatically) ---
PORT=3002

# --- Optional Telegram webhook mode (default is long-polling) ---
USE_WEBHOOK=false
PUBLIC_WEBHOOK_URL=

# --- Optional: driver-group speeding-video music overlay (ffmpeg) ---
# The feature is configured + the music uploaded from the admin/hub panel
# (bot-backend → Settings → Safety Event Music); this service reads it from the
# SHARED database and needs ffmpeg/ffprobe at runtime. If ffmpeg is absent the
# overlay simply no-ops (original video is sent). Leave blank to auto-detect the
# `ffmpeg-static` / `@ffprobe-installer/ffprobe` npm packages, then PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Hard timeout per ffmpeg invocation (ms).
SAFETY_MUSIC_FFMPEG_TIMEOUT_MS=60000
# Telegram bot uploads are rejected over 50 MB. Overlaid videos above this safe
# target (MB) are automatically re-encoded (music kept) to fit; capped at 49.5.
SAFETY_MUSIC_TELEGRAM_MAX_MB=49
# Timeout for a compression re-encode pass (ms) — heavier than the overlay copy.
SAFETY_MUSIC_COMPRESS_TIMEOUT_MS=90000
